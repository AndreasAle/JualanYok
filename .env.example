###############################################################################
# JualanYok — contoh environment. Salin ke .env lalu isi sesuai kebutuhan.
# Jangan pernah commit .env yang berisi kredensial asli.
###############################################################################

APP_NAME=JualanYok
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

# Google OAuth â€” buat kredensial "Web application" di Google Cloud Console.
# Authorized redirect URI harus sama persis dengan GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

###############################################################################
# Database
#
# SQLite dipakai sebagai default supaya aplikasi bisa langsung jalan.
# Untuk MySQL 8, ganti DB_CONNECTION=mysql dan isi kredensialnya.
###############################################################################

DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=jualanyok
# DB_USERNAME=root
# DB_PASSWORD=

###############################################################################
# Session, cache, queue
#
# Queue dipakai untuk email, webhook, fulfilment, dan analitik. Jalankan
# `php artisan queue:work` supaya job-job ini diproses.
###############################################################################

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

###############################################################################
# Storage
#
# `local` menyimpan file di storage/app (tidak bisa diakses publik — ini yang
# dipakai untuk produk digital). `public` untuk gambar. `s3` untuk produksi.
###############################################################################

FILESYSTEM_DISK=local

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

###############################################################################
# Email
#
# `log` menulis email ke storage/logs/laravel.log — cukup untuk development.
# Ganti ke smtp/ses/postmark saat produksi.
###############################################################################

MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="halo@jualanyok.test"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# Pembayaran
#
# Provider `mock` aktif secara default supaya seluruh alur checkout → ledger →
# fulfilment bisa dijalankan tanpa kredensial eksternal.
#
# Untuk produksi: matikan mock, aktifkan provider asli, dan isi kuncinya.
###############################################################################

PAYMENT_PROVIDER=mock
PAYMENT_EXPIRY_HOURS=24

PAYMENT_MOCK_ENABLED=true
PAYMENT_MOCK_SECRET=ganti-dengan-string-acak-panjang

PAYMENT_MANUAL_ENABLED=true

MIDTRANS_ENABLED=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_PRODUCTION=false

XENDIT_ENABLED=false
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

###############################################################################
# Aturan bisnis
#
# Nilai di sini hanya default awal. Setelah aplikasi jalan, super admin bisa
# mengubahnya dari /admin/pengaturan tanpa deploy ulang.
###############################################################################

PLATFORM_FEE_PERCENT=5
PLATFORM_FEE_FIXED=0
WITHDRAWAL_FEE=5000
MINIMUM_WITHDRAWAL=50000
HOLDING_PERIOD_DAYS=7
AFFILIATE_HOLD_DAYS=14

###############################################################################
# Demo
#
# DEMO_MODE=true mengaktifkan seeder demo dan tombol simulasi pembayaran.
# WAJIB false di produksi.
###############################################################################

DEMO_MODE=true

###############################################################################
# Lain-lain
###############################################################################

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

BROADCAST_CONNECTION=log
VITE_APP_NAME="${APP_NAME}"
