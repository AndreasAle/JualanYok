###############################################################################
# JualanYok — contoh environment. Salin ke .env lalu isi sesuai kebutuhan.
# Jangan pernah commit .env yang berisi kredensial asli.
#
# NILAI DI FILE INI UNTUK PENGEMBANGAN LOKAL.
#
# Kalau dipakai apa adanya di produksi, empat baris ini berbahaya:
#
#   APP_DEBUG=true       -> stack trace beserta isi konfigurasi tampil ke publik
#   APP_ENV=local        -> mode ketat menyala; sebagian halaman balas 500
#   DEMO_MODE=true       -> tombol "Simulasi Bayar Sukses" hidup: siapa pun bisa
#                           menandai pesanan lunas tanpa membayar
#   PAYMENT_PROVIDER=mock-> gateway tiruan, tidak ada uang sungguhan yang masuk
#
# Sebelum rilis, jalankan `php artisan jualanyok:preflight` — perintah itu
# memeriksa semuanya dan menolak lanjut kalau ada yang belum aman.
###############################################################################

APP_NAME=JualanYok
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

# Identitas usaha publik. Isi persis seperti data merchant yang didaftarkan ke
# payment gateway. Data ini tampil di halaman kontak dan footer website.
BUSINESS_NAME=JualanYok
BUSINESS_EMAIL=mail@conweb.id
BUSINESS_PHONE=
BUSINESS_ADDRESS=""

# Akun Creator terbatas untuk tim verifikasi iPaymu. Migration produksi akan
# membuat akun, toko publik, dan produk uji Rp10.000 dari nilai ini.
# Gunakan password sementara minimal 12 karakter dan ganti/hapus akun setelah
# proses verifikasi selesai. Jangan pernah commit password aslinya.
IPAYMU_REVIEW_NAME="Tim Verifikasi iPaymu"
IPAYMU_REVIEW_EMAIL=verifikasi.ipaymu@conweb.id
IPAYMU_REVIEW_USERNAME=reviewipaymu
IPAYMU_REVIEW_PASSWORD=
IPAYMU_REVIEW_STORE_USERNAME=uji-bayar-jualanyok
IPAYMU_REVIEW_STORE_NAME="Toko Uji Pembayaran JualanYok"

# Google OAuth â€” buat kredensial "Web application" di Google Cloud Console.
# Authorized redirect URI harus sama persis dengan GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

###############################################################################
# Database
#
# SQLite dipakai sebagai default supaya aplikasi bisa langsung jalan.
# Untuk MySQL 8, ganti DB_CONNECTION=mysql dan isi kredensialnya.
###############################################################################

DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=jualanyok
# DB_USERNAME=root
# DB_PASSWORD=

###############################################################################
# Session, cache, queue
#
# Queue dipakai untuk email, webhook, fulfilment, dan analitik. Jalankan
# `php artisan queue:work` supaya job-job ini diproses.
###############################################################################

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

###############################################################################
# Storage
#
# `local` menyimpan file di storage/app (tidak bisa diakses publik — ini yang
# dipakai untuk produk digital). `public` untuk gambar. `s3` untuk produksi.
###############################################################################

FILESYSTEM_DISK=local

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

###############################################################################
# Email
#
# `log` menulis email ke storage/logs/laravel.log — cukup untuk development.
# Ganti ke smtp/ses/postmark saat produksi.
###############################################################################

# --- Email ---
# Development: biarkan `log`, semua email masuk ke storage/logs/laravel.log.
# Produksi: ganti ke `smtp` dan isi kredensial di bawah.
#
# Contoh untuk email Hostinger (mis. mail@conweb.id):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.hostinger.com
#   MAIL_PORT=465
#   MAIL_SCHEME=smtps          <- port 465 memakai SSL implisit
#   MAIL_USERNAME=mail@conweb.id
#   MAIL_PASSWORD=...          <- ISI SENDIRI, jangan pernah di-commit
#   MAIL_FROM_ADDRESS=mail@conweb.id
#
# Kalau pakai port 587 (STARTTLS), set MAIL_PORT=587 dan MAIL_SCHEME=smtp.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="halo@jualanyok.test"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# Pembayaran
#
# Provider `mock` aktif secara default supaya seluruh alur checkout → ledger →
# fulfilment bisa dijalankan tanpa kredensial eksternal.
#
# Untuk produksi: matikan mock, aktifkan provider asli, dan isi kuncinya.
###############################################################################

PAYMENT_PROVIDER=mock
PAYMENT_EXPIRY_HOURS=24

PAYMENT_MOCK_ENABLED=true
PAYMENT_MOCK_SECRET=ganti-dengan-string-acak-panjang

PAYMENT_MANUAL_ENABLED=true

# iPaymu API v2. Sandbox dan Live memakai pasangan VA/API Key berbeda.
# Jangan pernah commit nilai aslinya; isi hanya di .env server.
IPAYMU_ENABLED=false
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_PRODUCTION=false
# redirect = halaman checkout iPaymu (jalan di semua akun).
# direct   = QR di dalam JualanYok, butuh akun yang disetujui iPaymu untuk API charging.
IPAYMU_MODE=redirect
IPAYMU_FEE_DIRECTION=MERCHANT

MIDTRANS_ENABLED=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_PRODUCTION=false

XENDIT_ENABLED=false
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

###############################################################################
# Aturan bisnis
#
# Nilai di sini hanya default awal. Setelah aplikasi jalan, super admin bisa
# mengubahnya dari /admin/pengaturan tanpa deploy ulang.
###############################################################################

PLATFORM_FEE_PERCENT=5
PLATFORM_FEE_FIXED=0
WITHDRAWAL_FEE=5000
MINIMUM_WITHDRAWAL=50000
HOLDING_PERIOD_DAYS=7
AFFILIATE_HOLD_DAYS=14

# Unit economics marketplace. Biaya aktual dari gateway tetap menjadi sumber
# utama; angka ini adalah fallback dan dapat diubah tanpa mengedit kode.
MARKETPLACE_GATEWAY_FEE_BEARER=SELLER
MARKETPLACE_MINIMUM_NET_TRANSACTION=1000
IPAYMU_QRIS_COST_PERCENT=0.7
IPAYMU_QRIS_COST_FIXED=0
IPAYMU_QRIS_SETTLEMENT_DAYS=2
MARKETPLACE_RESERVE_ENABLED=true
MARKETPLACE_RESERVE_PERCENT=2
MARKETPLACE_PHYSICAL_RESERVE_PERCENT=5
MARKETPLACE_NEW_SELLER_RESERVE_BONUS=2
MARKETPLACE_NEW_SELLER_ORDER_THRESHOLD=10
MARKETPLACE_MAX_RESERVE_PERCENT=10
MARKETPLACE_RESERVE_RELEASE_DAYS=30
IPAYMU_SPLIT_ENABLED=false
IPAYMU_SPLIT_FEE=150
IPAYMU_SPLIT_MINIMUM=500
PAYOUT_PROVIDER_COST=3000
ECONOMICS_WARNING_MARGIN_PERCENT=1
ECONOMICS_CRITICAL_MARGIN_PERCENT=0
ECONOMICS_REFUND_WARNING_PERCENT=5
ECONOMICS_BITESHIP_DAILY_WARNING=100000
BITESHIP_AREAS_CACHE_MINUTES=1440
BITESHIP_RATES_CACHE_MINUTES=10
BITESHIP_TRACKING_CACHE_MINUTES=5
BITESHIP_MAPS_COST=2
BITESHIP_RATES_COST=5
BITESHIP_TRACKING_COST=10

###############################################################################
# Demo
#
# DEMO_MODE=true mengaktifkan seeder demo dan tombol simulasi pembayaran.
# WAJIB false di produksi.
###############################################################################

DEMO_MODE=true

###############################################################################
# Lain-lain
###############################################################################

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

BROADCAST_CONNECTION=log
VITE_APP_NAME="${APP_NAME}"

###############################################################################
# Logistik produk fisik
#
# Fallback manual tetap aktif saat Biteship belum dihubungkan. Untuk tarif,
# booking kurir, waybill, dan tracking otomatis isi token dari dashboard
# Biteship. Token test memakai prefix biteship_test.; live biteship_live.
###############################################################################

SHIPPING_PROVIDER=manual
SHIPPING_QUOTE_TTL_MINUTES=30
SHIPPING_COMPLAINT_WINDOW_DAYS=2
SHIPPING_AUTO_COMPLETE_DAYS=2
SHIPPING_MANUAL_FLAT_RATE=15000
SHIPPING_MANUAL_FREE_OVER=0
SHIPPING_MANUAL_ESTIMATED_DAYS="2 - 5 hari"

BITESHIP_ENABLED=false
BITESHIP_API_TOKEN=
BITESHIP_BASE_URL=https://api.biteship.com
BITESHIP_COURIERS=jne,sicepat,anteraja,jnt,ninja,tiki,pos
BITESHIP_WEBHOOK_HEADER=X-Callback-Token
BITESHIP_WEBHOOK_SECRET=
BITESHIP_TIMEOUT=15

# --- Pembayaran QRIS manual untuk paket langganan ---
# Tempel string QRIS STATIS milik merchant kamu (bukan gambar, tapi teks di
# dalam QR-nya). Jangan pernah commit nilai ini ke git.
#
# WAJIB pakai tanda kutip: payload QRIS memuat nama kota yang biasanya
# mengandung spasi, dan tanpa kutip Laravel gagal membaca file .env.
QRIS_ENABLED=false
QRIS_STATIC_PAYLOAD=""
QRIS_WINDOW_MINUTES=30
# Aktifkan QRIS sebagai metode bayar di checkout produk (bukan cuma paket).
QRIS_CHECKOUT_ENABLED=false
QRIS_FEE_PERCENT=0.7

# Where uploaded media lives. Leave as "public" to serve from this server, or
# point it at an S3-compatible bucket (Cloudflare R2, Spaces, Wasabi) once
# video traffic outgrows the host's bandwidth allowance. Every upload path
# follows this one setting.
MEDIA_DISK=public
